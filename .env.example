# Copy this file to .env (repo root, git-ignored) and fill in real values.
# Read at build time by the secrets Gradle plugin (root-level .env) and exposed as BuildConfig fields.

# OAuth 2.0 Web Client ID used by Google Sign-In (Credential Manager).
# Google Cloud Console > APIs & Services > Credentials > "Web client (auto created by Google Service)"
WEB_CLIENT_ID=livepulse-firebase-auth.apps.googleusercontent.com

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
